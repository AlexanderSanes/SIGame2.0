# Скопировать в /etc/sigame.env и заменить домен.
PUBLIC_URL=https://game.example.com
HOST=127.0.0.1
# Включается после настройки nginx Basic Auth для /admin и /api/admin и HTTPS.
ADMIN_PROXY_ENABLED=0
PORT=3000
DATA_DIR=/var/lib/sigame
SNAPSHOT_INTERVAL_MS=10000
CLEANUP_INTERVAL_MS=60000
ROOM_IDLE_MS=7200000
MEDIA_GRACE_MS=86400000
